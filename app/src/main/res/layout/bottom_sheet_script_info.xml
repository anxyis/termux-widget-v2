<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_sheet_bg"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:id="@+id/sheet_drag_handle"
        android:layout_width="38dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/widget_pill_badge_bg"
        android:backgroundTint="@color/m3_outline"
        android:layout_marginBottom="16dp" />

    <!-- Hero Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp">

        <FrameLayout
            android:id="@+id/sheet_icon_frame"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/widget_icon_badge_bg"
            android:layout_marginEnd="16dp">

            <ImageView
                android:id="@+id/sheet_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lucide_terminal"
                app:tint="@color/m3_primary"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sheet_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/m3_on_surface"
                android:ellipsize="middle"
                android:singleLine="true" />

            <TextView
                android:id="@+id/sheet_path"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/m3_on_surface_variant"
                android:ellipsize="middle"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/sheet_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_pill_badge_bg"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/badge_task_text" />

                <TextView
                    android:id="@+id/sheet_group_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_pill_session_bg"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/badge_session_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Primary Action: Oversized Bento Run Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/sheet_btn_run"
        style="@style/Widget.TermuxWidget.Button.Capsule"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="Run Script"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="20dp"
        app:icon="@drawable/ic_lucide_play"
        app:iconGravity="textStart"
        app:iconSize="20dp"
        app:backgroundTint="@color/m3_primary"
        android:textColor="@color/m3_on_primary"
        app:iconTint="@color/m3_on_primary"
        android:layout_marginBottom="16dp" />

    <!-- Secondary Actions Container: Bento Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sheet_secondary_card"
        style="@style/Widget.TermuxWidget.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="@color/m3_surface_container_high">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Customize Name & Icon (Cosmetic) -->
            <LinearLayout
                android:id="@+id/sheet_action_appearance"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/sheet_icon_appearance"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_lucide_palette"
                    app:tint="@color/m3_primary"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/sheet_txt_appearance_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Customize Name &amp; Icon"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_on_surface" />

                    <TextView
                        android:id="@+id/sheet_txt_appearance_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Set custom label and icon for widgets"
                        android:textSize="11sp"
                        android:textColor="@color/m3_on_surface_variant" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/sheet_arrow_appearance"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_lucide_chevron_right"
                    app:tint="@color/m3_on_surface_variant"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View
                android:id="@+id/sheet_divider_1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/m3_outline_variant" />

            <!-- Change Category / Group -->
            <LinearLayout
                android:id="@+id/sheet_action_group"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/sheet_icon_group"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_lucide_folder"
                    app:tint="@color/m3_primary"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/sheet_txt_group_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Change Category / Group"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_on_surface" />

                    <TextView
                        android:id="@+id/sheet_txt_group_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Organize into app groups"
                        android:textSize="11sp"
                        android:textColor="@color/m3_on_surface_variant" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/sheet_arrow_group"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_lucide_chevron_right"
                    app:tint="@color/m3_on_surface_variant"
                    android:contentDescription="@null" />
            </LinearLayout>

            <View
                android:id="@+id/sheet_divider_2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/m3_outline_variant" />

            <!-- Pin to Launcher -->
            <LinearLayout
                android:id="@+id/sheet_action_pin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/sheet_icon_pin"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_hero_bolt"
                    app:tint="@color/m3_on_surface"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/sheet_txt_pin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pin to Home Screen"
                    android:textSize="14sp"
                    android:textColor="@color/m3_on_surface" />
            </LinearLayout>

            <View
                android:id="@+id/sheet_divider_3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/m3_outline_variant" />

            <!-- Assign to Quick Tile -->
            <LinearLayout
                android:id="@+id/sheet_action_tile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/sheet_icon_tile"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_lucide_settings"
                    app:tint="@color/m3_on_surface"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/sheet_txt_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Assign to Quick Settings Tile"
                    android:textSize="14sp"
                    android:textColor="@color/m3_on_surface" />
            </LinearLayout>

            <View
                android:id="@+id/sheet_divider_4"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/m3_outline_variant" />

            <!-- Copy Path / Command -->
            <LinearLayout
                android:id="@+id/sheet_action_copy"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/sheet_icon_copy"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_lucide_copy"
                    app:tint="@color/m3_on_surface"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/sheet_txt_copy_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Copy Script Path"
                    android:textSize="14sp"
                    android:textColor="@color/m3_on_surface" />
            </LinearLayout>

            <!-- Custom Command: Edit Action -->
            <LinearLayout
                android:id="@+id/sheet_action_edit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/sheet_icon_edit"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_lucide_code"
                    app:tint="@color/m3_on_surface"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/sheet_txt_edit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Edit Custom Command"
                    android:textSize="14sp"
                    android:textColor="@color/m3_on_surface" />
            </LinearLayout>

            <!-- Custom Command: Delete Action -->
            <LinearLayout
                android:id="@+id/sheet_action_delete"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/sheet_icon_delete"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_lucide_trash"
                    app:tint="@color/status_disconnected"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/sheet_txt_delete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Delete Custom Command"
                    android:textSize="14sp"
                    android:textColor="@color/status_disconnected" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
