<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:background="@drawable/ripple_mask">

    <!-- Left: Independent Circular Icon Badge -->
    <FrameLayout
        android:id="@+id/widget_item_icon_badge"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/widget_list_circle_icon_bg"
        android:layout_marginEnd="10dp">

        <ImageView
            android:id="@+id/widget_item_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_hero_bolt"
            android:tint="@color/widget_list_badge_icon"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_item_custom_image"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:scaleType="centerInside"
            android:visibility="gone"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Right: Material You Rounded Card Container -->
    <LinearLayout
        android:id="@+id/widget_item_card_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_list_card_bg">

        <TextView
            android:id="@+id/widget_item"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical|start"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_color"
            android:ellipsize="middle"
            android:singleLine="true" />

    </LinearLayout>

</LinearLayout>