<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_container_bg"
    android:padding="16dp">

    <!-- Top Handle Indicator -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/widget_pill_badge_bg" />

    <!-- Title & Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_icon_picker"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/m3_on_surface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select from over 300+ vector icons across all categories"
        android:textSize="12sp"
        android:textColor="@color/m3_on_surface_variant"
        android:layout_marginBottom="12dp" />

    <!-- Search Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_search_icons"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:startIconDrawable="@drawable/ic_lucide_search"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_search_icons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/search_icons_hint"
            android:textSize="14sp"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Category Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_all"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/icon_cat_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_dev"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_cat_dev" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_servers"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_cat_servers" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_selfhosted"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_cat_selfhosted" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_power"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_cat_power" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_system"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_cat_system" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_files"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_cat_files" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_hardware"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_cat_hardware" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_media"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_cat_media" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_security"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_cat_security" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_tools"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_cat_tools" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Grid of Icons -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_icons"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

</LinearLayout>
