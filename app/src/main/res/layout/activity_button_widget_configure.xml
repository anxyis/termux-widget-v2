<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/m3_surface">

    <!-- Top Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_button_config"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/m3_surface"
        app:title="@string/widget_configure_button_title"
        app:titleTextColor="@color/m3_on_surface"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:navigationIcon="@drawable/ic_lucide_chevron_right" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Live Interactive Preview Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WIDGET PREVIEW"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/m3_primary"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.TermuxWidget.Card"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/m3_surface_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home Screen Appearance"
                        android:textSize="12sp"
                        android:textColor="@color/m3_on_surface_variant"
                        android:layout_marginBottom="14dp" />

                    <!-- Live widget container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/widget_container_bg"
                        android:padding="6dp"
                        android:gravity="center">

                        <include
                            layout="@layout/widget_button_layout"
                            android:id="@+id/preview_button_widget"
                            android:layout_width="match_parent"
                            android:layout_height="56dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: Grouped Configuration Block (PixelPlayer SettingsCard Pattern) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHORTCUT SETTINGS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/m3_on_surface_variant"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.TermuxWidget.Card"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/m3_surface_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Script Selection Row -->
                    <LinearLayout
                        android:id="@+id/card_select_script"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/widget_icon_badge_bg"
                            android:layout_marginEnd="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_lucide_code"
                                app:tint="@color/m3_primary"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/quick_tile_select_shortcut"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/m3_on_surface" />

                            <TextView
                                android:id="@+id/txt_selected_script"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Tap to select script"
                                android:textSize="12sp"
                                android:textColor="@color/m3_on_surface_variant"
                                android:ellipsize="middle"
                                android:singleLine="true" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_lucide_chevron_right"
                            app:tint="@color/m3_on_surface_variant"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/m3_outline_variant" />

                    <!-- Icon Selection Row -->
                    <LinearLayout
                        android:id="@+id/card_select_icon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/widget_icon_badge_bg"
                            android:layout_marginEnd="14dp">

                            <ImageView
                                android:id="@+id/img_chosen_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_lucide_terminal"
                                app:tint="@color/m3_primary"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/quick_tile_choose_icon"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/m3_on_surface" />

                            <TextView
                                android:id="@+id/txt_chosen_icon_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Terminal (Lucide)"
                                android:textSize="12sp"
                                android:textColor="@color/m3_on_surface_variant" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_lucide_chevron_right"
                            app:tint="@color/m3_on_surface_variant"
                            android:contentDescription="@null" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Custom Display Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISPLAY LABEL"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/m3_on_surface_variant"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_button_label"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                android:hint="@string/quick_tile_label"
                app:helperText="Optional custom name shown on your home screen">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_button_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Spacer that pushes apply button if screen has surplus height -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Primary Action: Capsule Apply Button (PixelPlayer primary button pattern) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_widget"
                style="@style/Widget.TermuxWidget.Button.Capsule"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Apply to Widget"
                android:textSize="15sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_lucide_check"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:backgroundTint="@color/m3_primary"
                android:textColor="@color/m3_on_primary"
                app:iconTint="@color/m3_on_primary" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
