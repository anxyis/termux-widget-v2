<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_container_bg"
    android:padding="0dp">

    <!-- Compact Header Row -->
    <LinearLayout
        android:id="@+id/top_row"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_lucide_terminal" />

        <TextView
            android:id="@+id/txt_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_termux_shortcuts"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/m3_on_surface"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/txt_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:textSize="11sp"
            android:textColor="@color/m3_on_surface_variant" />

        <ImageButton
            android:id="@+id/refresh_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_header_btn_bg"
            android:src="@drawable/ic_hero_arrow_path"
            android:contentDescription="@string/action_refresh"
            android:padding="5dp" />
    </LinearLayout>

    <!-- Header Divider (ImageView is allowed in RemoteViews, View is not) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@null"
        android:src="@color/m3_outline_variant" />

    <!-- Scrollable Shortcuts Collection -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/m3_outline_variant"
            android:dividerHeight="1px"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:paddingBottom="2dp" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lucide_folder" />

            <TextView
                android:id="@+id/txt_empty_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/msg_no_shortcut_scripts"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="@color/m3_on_surface_variant" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>