<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_shortcut_row"
    style="@style/Widget.TermuxWidget.Card.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/nothing_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageView
            android:id="@+id/row_shortcut_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/widget_pill_badge_bg"
            android:padding="4dp"
            android:src="@drawable/ic_lucide_terminal"
            android:layout_marginEnd="10dp"
            app:tint="@color/nothing_text_primary"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row_shortcut_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/nothing_text_primary"
                android:singleLine="true"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/row_shortcut_path"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/nothing_text_secondary"
                android:singleLine="true"
                android:ellipsize="middle" />
        </LinearLayout>

        <TextView
            android:id="@+id/row_shortcut_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_badge_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="@color/nothing_text_secondary"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/row_btn_run"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="34dp"
            android:layout_height="34dp"
            app:icon="@drawable/ic_lucide_play"
            app:iconSize="14dp"
            app:iconTint="@color/nothing_red"
            app:backgroundTint="@color/nothing_red_dim"
            android:contentDescription="Run Script" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
