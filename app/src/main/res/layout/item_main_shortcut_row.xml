<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_shortcut_row"
    style="@style/Widget.TermuxWidget.Card.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/row_shortcut_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_pill_badge_bg"
            android:padding="6dp"
            android:src="@drawable/ic_lucide_terminal"
            android:layout_marginEnd="12dp"
            app:tint="@color/m3_primary"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row_shortcut_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/m3_on_surface"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/row_shortcut_path"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/m3_on_surface_variant"
                android:singleLine="true"
                android:ellipsize="middle" />
        </LinearLayout>

        <TextView
            android:id="@+id/row_shortcut_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_badge_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/badge_session_text"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/row_btn_run"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_lucide_play"
            app:iconTint="@color/m3_on_primary"
            app:backgroundTint="@color/m3_primary"
            android:contentDescription="Run Script" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
