<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_shortcut_row"
    style="@style/Widget.TermuxWidget.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Leading Icon Badge (Oversized Bento Shape) -->
        <FrameLayout
            android:id="@+id/row_shortcut_icon_badge"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_icon_badge_bg"
            android:layout_marginEnd="16dp">

            <ImageView
                android:id="@+id/row_shortcut_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lucide_terminal"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/row_shortcut_custom_image"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:visibility="gone"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Center Details (Name & Path) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row_shortcut_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:singleLine="true"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/row_shortcut_path"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:singleLine="true"
                android:ellipsize="middle" />
        </LinearLayout>

        <!-- Badge & Action Group -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/row_shortcut_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_badge_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/badge_task_text"
                android:layout_marginEnd="10dp" />

            <!-- Primary Circular Run Button (Guaranteed Centered Play Icon) -->
            <FrameLayout
                android:id="@+id/row_btn_run"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_run_button_bg"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/img_row_btn_run"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_arrow_centered"
                    app:tint="?attr/colorOnPrimary"
                    android:contentDescription="Run Script" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
