<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_button_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/widget_button_single_bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/widget_button_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_lucide_terminal" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_button_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_button_widget_name"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/m3_on_primary_container"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_button_sublabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to Run"
            android:textSize="10sp"
            android:textColor="@color/m3_primary"
            android:maxLines="1" />
    </LinearLayout>

</LinearLayout>
