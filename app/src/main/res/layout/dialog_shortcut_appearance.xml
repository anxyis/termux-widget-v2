<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appearance_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_sheet_bg"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:id="@+id/appearance_drag_handle"
        android:layout_width="38dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/widget_pill_badge_bg"
        android:backgroundTint="@color/m3_outline"
        android:layout_marginBottom="16dp" />

    <!-- Header -->
    <TextView
        android:id="@+id/appearance_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Customize Shortcut"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/m3_on_surface" />

    <TextView
        android:id="@+id/appearance_header_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="14dp"
        android:text="In-app &amp; widget appearance. Physical scripts remain untouched."
        android:textSize="12sp"
        android:textColor="@color/m3_on_surface_variant" />

    <!-- Live Preview Bento Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/appearance_preview_card"
        style="@style/Widget.TermuxWidget.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="@color/m3_surface_container_high">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <FrameLayout
                android:id="@+id/preview_icon_container"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/widget_icon_badge_bg"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/appearance_preview_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lucide_terminal"
                    app:tint="@color/m3_primary"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/appearance_preview_custom_image"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:scaleType="centerInside"
                    android:visibility="gone"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/appearance_preview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shortcut Name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_on_surface"
                    android:singleLine="true"
                    android:ellipsize="middle" />

                <TextView
                    android:id="@+id/appearance_preview_path"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="~/.shortcuts/script.sh"
                    android:textSize="12sp"
                    android:textColor="@color/m3_on_surface_variant"
                    android:singleLine="true"
                    android:ellipsize="middle" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Custom Display Name Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_appearance_label"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxCornerRadiusTopStart="18dp"
        app:boxCornerRadiusTopEnd="18dp"
        app:boxCornerRadiusBottomStart="18dp"
        app:boxCornerRadiusBottomEnd="18dp"
        android:hint="Custom Display Name"
        app:helperText="Override how this script appears in widget lists and grids">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_appearance_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Category / Group Field (In-App Sorting) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_appearance_group"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:boxCornerRadiusTopStart="18dp"
        app:boxCornerRadiusTopEnd="18dp"
        app:boxCornerRadiusBottomStart="18dp"
        app:boxCornerRadiusBottomEnd="18dp"
        android:hint="Category / Group (In-App)"
        app:helperText="Group name for sorting &amp; filter chips (e.g. Work, SSH, Media)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_appearance_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Choose Icon Button (Fat Bento Button) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_appearance_pick_icon"
        style="@style/Widget.TermuxWidget.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="14dp"
        android:text="Choose Icon from Library"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="18dp"
        app:icon="@drawable/ic_lucide_palette"
        app:iconSize="20dp"
        app:iconTint="@color/m3_primary"
        android:textColor="@color/m3_primary"
        app:backgroundTint="@color/m3_surface_container_high" />

    <!-- Action Buttons: Oversized Bento Stacking -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_appearance_save"
        style="@style/Widget.TermuxWidget.Button.Capsule"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginBottom="10dp"
        android:text="Save Appearance"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="20dp"
        app:icon="@drawable/ic_lucide_check"
        app:iconGravity="textStart"
        app:iconSize="20dp"
        app:backgroundTint="@color/m3_primary"
        android:textColor="@color/m3_on_primary"
        app:iconTint="@color/m3_on_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_appearance_reset"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:text="Reset to Default"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="18dp"
            app:backgroundTint="@color/m3_surface_container_high"
            android:textColor="@color/m3_on_surface"
            app:icon="@drawable/ic_hero_arrow_path"
            app:iconSize="18dp"
            app:iconTint="@color/m3_on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_appearance_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="Cancel"
            android:textSize="13sp"
            android:textColor="@color/m3_on_surface_variant" />
    </LinearLayout>

</LinearLayout>
