<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_toggle_row"
    style="@style/Widget.TermuxWidget.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Leading Icon Badge (Oversized Bento Shape) -->
        <FrameLayout
            android:id="@+id/toggle_badge_frame"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/widget_icon_badge_bg"
            android:layout_marginEnd="16dp">

            <ImageView
                android:id="@+id/img_toggle_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lucide_power"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/img_toggle_custom_image"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:visibility="gone"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Center Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_toggle_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:singleLine="true"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/txt_toggle_scripts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:singleLine="true"
                android:ellipsize="middle" />
        </LinearLayout>

        <!-- Status Pill & Switch -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/txt_toggle_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_session_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:text="OFF"
                android:textColor="@color/badge_session_text"
                android:layout_marginEnd="10dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_toggle_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
