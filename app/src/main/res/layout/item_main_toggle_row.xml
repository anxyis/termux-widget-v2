<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_toggle_row"
    style="@style/Widget.TermuxWidget.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/m3_surface_container"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Leading Icon Badge -->
        <FrameLayout
            android:id="@+id/toggle_badge_frame"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/widget_icon_badge_bg"
            android:layout_marginEnd="14dp">

            <ImageView
                android:id="@+id/img_toggle_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lucide_power"
                app:tint="@color/m3_primary"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/img_toggle_custom_image"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:visibility="gone"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Center Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_toggle_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/m3_on_surface"
                android:singleLine="true"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/txt_toggle_scripts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:textColor="@color/m3_on_surface_variant"
                android:singleLine="true"
                android:ellipsize="middle" />
        </LinearLayout>

        <!-- Status Pill & Switch -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/txt_toggle_status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_session_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:text="OFF"
                android:textColor="@color/badge_session_text"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_toggle_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
