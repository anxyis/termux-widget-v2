<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Material You Card with Rounded Corners -->
    <LinearLayout
        android:id="@+id/widget_grid_item_layout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_grid_card_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/widget_grid_item_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_color"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="middle" />
    </LinearLayout>

    <!-- Material You Dynamic Accent Circle Badge Overlapping Top Edge -->
    <FrameLayout
        android:id="@+id/widget_grid_item_icon_badge"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/widget_grid_purple_circle_bg">

        <ImageView
            android:id="@+id/widget_grid_item_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_hero_bolt"
            android:tint="@color/widget_accent_circle_icon"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_grid_item_custom_image"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:scaleType="centerInside"
            android:visibility="gone"
            android:contentDescription="@null" />
    </FrameLayout>

</RelativeLayout>
