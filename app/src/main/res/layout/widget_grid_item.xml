<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_grid_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="3dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Material You Card with Horizontal Layout: Icon on Left, Text on Right -->
    <LinearLayout
        android:id="@+id/widget_grid_item_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:background="@drawable/widget_grid_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Icon Badge on Left -->
        <FrameLayout
            android:id="@+id/widget_grid_item_icon_badge"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="10dp">

            <ImageView
                android:id="@+id/widget_grid_item_badge_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_badge_circle_solid"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_grid_item_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_hero_bolt"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_grid_item_custom_image"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:visibility="gone"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Script Label on Right -->
        <TextView
            android:id="@+id/widget_grid_item_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_color"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
