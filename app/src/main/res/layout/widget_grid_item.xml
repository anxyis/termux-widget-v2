<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_grid_item_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_grid_item_bg"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_grid_item_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/widget_pill_badge_bg"
        android:padding="4dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_lucide_terminal" />

    <TextView
        android:id="@+id/widget_grid_item_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/nothing_text_primary"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_grid_item_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_pill_badge_bg"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:textSize="8sp"
        android:textStyle="bold"
        android:textColor="@color/nothing_text_secondary" />

</LinearLayout>
