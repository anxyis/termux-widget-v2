<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/m3_surface"
    tools:context=".activities.TermuxWidgetMainActivity">

    <!-- Compact Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/main_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/m3_surface"
        app:title="@string/title_termux_shortcuts"
        app:titleTextColor="@color/m3_on_surface"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Compact Status & Sync Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_status_banner"
                style="@style/Widget.TermuxWidget.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/m3_primary_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/img_status_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_lucide_terminal"
                            android:layout_marginEnd="10dp"
                            app:tint="@color/m3_on_primary_container"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_status_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Termux Connected"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/m3_on_primary_container" />

                            <TextView
                                android:id="@+id/txt_status_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 shortcuts loaded"
                                android:textSize="11sp"
                                android:textColor="@color/m3_on_primary_container" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Compact Visual Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_refresh_shortcuts"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="Sync from Termux"
                            android:textSize="11sp"
                            app:icon="@drawable/ic_hero_arrow_path"
                            app:iconSize="14dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_refresh_all_widgets"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:text="Refresh Widgets"
                            android:textSize="11sp"
                            app:icon="@drawable/ic_lucide_terminal"
                            app:iconSize="14dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Compact Setup Helper -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_setup_guide"
                style="@style/Widget.TermuxWidget.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Needs 'allow-external-apps=true' in Termux for shortcut sync"
                        android:textSize="11sp"
                        android:textColor="@color/m3_on_surface_variant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_copy_setup_command"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Copy Setup"
                        android:textSize="11sp"
                        android:padding="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_app_settings"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Permissions"
                        android:textSize="11sp"
                        android:padding="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Tiles Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Settings Tiles (8 Slots)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/m3_primary"
                android:layout_marginBottom="6dp" />

            <!-- Quick Tiles Grid -->
            <GridLayout
                android:id="@+id/grid_quick_tiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginBottom="16dp" />

            <!-- Shortcuts Header & Add Command Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Shortcuts &amp; Commands"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_command"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="+ Add Command"
                    android:textSize="11sp"
                    android:padding="0dp" />
            </LinearLayout>

            <!-- Shortcuts Container -->
            <LinearLayout
                android:id="@+id/container_detected_shortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
