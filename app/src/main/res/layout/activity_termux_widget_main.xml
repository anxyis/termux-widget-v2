<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/m3_surface"
    tools:context=".activities.TermuxWidgetMainActivity">

    <!-- Material 3 Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/main_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/m3_surface"
        app:title="@string/title_termux_shortcuts"
        app:titleTextColor="@color/m3_on_surface"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- System Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_status_banner"
                style="@style/Widget.TermuxWidget.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/m3_primary_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/img_status_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_lucide_terminal"
                        android:layout_marginEnd="14dp"
                        app:tint="@color/m3_on_primary_container" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_status_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Termux Connected"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/m3_on_primary_container" />

                        <TextView
                            android:id="@+id/txt_status_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 shortcuts detected in ~/.shortcuts/"
                            android:textSize="12sp"
                            android:textColor="@color/m3_on_primary_container" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Setup & Pairing Guide Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_setup_guide"
                style="@style/Widget.TermuxWidget.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Termux v2 Setup (1-Time)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_primary"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Run the command below in Termux to allow external app commands.\n2. Ensure 'Run commands in Termux' permission is granted in Android App Settings."
                        android:textSize="12sp"
                        android:textColor="@color/m3_on_surface_variant"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_copy_setup_command"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Copy Setup Command"
                            android:textSize="11sp"
                            app:icon="@drawable/ic_lucide_copy"
                            app:cornerRadius="14dp"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_open_app_settings"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="App Permissions"
                            android:textSize="11sp"
                            app:icon="@drawable/ic_lucide_settings"
                            app:cornerRadius="14dp"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Settings Tiles Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_quick_tiles"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/m3_primary"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_quick_tiles_desc"
                android:textSize="12sp"
                android:textColor="@color/m3_on_surface_variant"
                android:layout_marginBottom="12dp" />

            <GridLayout
                android:id="@+id/grid_quick_tiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="4"
                android:layout_marginBottom="24dp">
                <!-- Tile slot cards populated dynamically in Java -->
            </GridLayout>

            <!-- Detected Shortcuts Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_shortcuts"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/m3_primary"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_command"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Add"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_lucide_plus"
                    app:cornerRadius="18dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_refresh_shortcuts"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_hero_arrow_path"
                    app:iconTint="@color/m3_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/container_detected_shortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
                <!-- Shortcut cards populated in Java -->
            </LinearLayout>

            <!-- Widget Varieties Showcase -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_widgets"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/m3_primary"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TermuxWidget.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. List Widget (Dynamic Sizing)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_on_surface" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scrollable list with group dividers, task badges, and real-time script counts."
                        android:textSize="12sp"
                        android:textColor="@color/m3_on_surface_variant"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Grid Widget (Squircle Icons)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_on_surface" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Modern card grid with centered icons, perfect for square 2x2 home screen slots."
                        android:textSize="12sp"
                        android:textColor="@color/m3_on_surface_variant"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3. Button Widget (Single Direct Action)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/m3_on_surface" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dedicated one-tap button with custom Lucide / Phosphor / Heroicon icon."
                        android:textSize="12sp"
                        android:textColor="@color/m3_on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tools & Maintenance Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tools &amp; Management"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/m3_primary"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.TermuxWidget.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_refresh_all_widgets"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_refresh_all_widgets"
                        app:icon="@drawable/ic_hero_arrow_path"
                        app:cornerRadius="14dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_create_dynamic_shortcuts"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/action_create_dynamic_shortcuts"
                            android:textSize="11sp"
                            app:cornerRadius="14dp"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_remove_dynamic_shortcuts"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/action_remove_dynamic_shortcuts"
                            android:textSize="11sp"
                            app:cornerRadius="14dp"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
