<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    tools:context=".activities.TermuxWidgetMainActivity">

    <!-- Expressive Bento Top Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/main_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?android:attr/colorBackground"
        app:title="Termux Shortcuts"
        app:titleTextColor="?attr/colorOnSurface"
        app:titleTextAppearance="@style/TextAppearance.TermuxWidget.ToolbarTitle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Compact Connection & Sync Strip (Bento Card) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_status_banner"
                style="@style/Widget.TermuxWidget.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:id="@+id/status_badge_frame"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/widget_icon_badge_bg"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:id="@+id/img_status_icon"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_hero_bolt"
                                app:tint="?attr/colorPrimary"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_status_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Connected to Termux"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/txt_status_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="~/.shortcuts/ • 0 shortcuts"
                                android:textSize="13sp"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <!-- Refresh All Widgets Action (Guaranteed Centered Circular Button) -->
                        <FrameLayout
                            android:id="@+id/button_refresh_all_widgets"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/circle_refresh_button_bg"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/img_refresh_all_widgets"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_hero_arrow_path"
                                app:tint="?attr/colorPrimary"
                                android:contentDescription="Refresh Widgets" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Oversized Fat Sync Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_refresh_shortcuts"
                        style="@style/Widget.TermuxWidget.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="16dp"
                        android:text="Sync Scripts from Termux"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="20dp"
                        app:backgroundTint="?attr/colorSurfaceContainerHigh"
                        android:textColor="?attr/colorPrimary"
                        app:icon="@drawable/ic_hero_arrow_path"
                        app:iconTint="?attr/colorPrimary"
                        app:iconSize="22dp" />

                    <!-- AMOLED Pure Black Display Option -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <ImageView
                            android:id="@+id/img_amoled_moon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_lucide_moon"
                            app:tint="?attr/colorOnSurface"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_amoled_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AMOLED Pure Black"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/txt_amoled_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Pitch black #000000 background"
                                android:textSize="12sp"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_amoled_theme"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section Header: Scripts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/txt_shortcuts_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scripts : 0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <FrameLayout
                    android:id="@+id/btn_help_scripts"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Scripts Help"
                    android:tooltipText="Termux scripts from ~/.shortcuts/ or custom commands. Tap to run or customize.">

                    <ImageView
                        android:id="@+id/img_help_scripts"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lucide_circle_help"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </FrameLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/btn_add_command"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bento_plus_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="New Command"
                    android:tooltipText="Add New Command">

                    <ImageView
                        android:id="@+id/img_add_command"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lucide_plus"
                        app:tint="?attr/colorOnPrimaryContainer" />
                </FrameLayout>
            </LinearLayout>

            <!-- Shortcuts Container -->
            <LinearLayout
                android:id="@+id/container_detected_shortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp" />

            <!-- Section Header: Toggles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/txt_toggles_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toggles : 0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <FrameLayout
                    android:id="@+id/btn_help_toggles"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Toggles Help"
                    android:tooltipText="Pair two scripts into a single ON/OFF switch for widgets and quick tiles.">

                    <ImageView
                        android:id="@+id/img_help_toggles"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lucide_circle_help"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </FrameLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/btn_add_toggle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bento_plus_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="New Toggle"
                    android:tooltipText="Add New Toggle">

                    <ImageView
                        android:id="@+id/img_add_toggle"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lucide_plus"
                        app:tint="?attr/colorOnPrimaryContainer" />
                </FrameLayout>
            </LinearLayout>

            <!-- Toggles Container -->
            <LinearLayout
                android:id="@+id/container_toggle_shortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp" />

            <!-- SECONDARY SECTION: Quick Settings Tiles (Collapsible / Non-dominating) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_tiles_section"
                style="@style/Widget.TermuxWidget.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:id="@+id/header_quick_tiles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <FrameLayout
                            android:id="@+id/tiles_badge_frame"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/widget_icon_badge_bg"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:id="@+id/img_tiles_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_lucide_settings"
                                app:tint="?attr/colorPrimary"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_tiles_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quick Settings Tiles"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/txt_tiles_summary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Configure tiles for Android Control Center"
                                android:textSize="13sp"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/img_tiles_expand_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_lucide_chevron_right"
                            app:tint="?attr/colorOnSurfaceVariant"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <!-- Expandable Tiles Grid -->
                    <LinearLayout
                        android:id="@+id/container_tiles_expandable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="16dp">

                        <GridLayout
                            android:id="@+id/grid_quick_tiles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TERTIARY SECTION: Bento Setup Guide & Permissions (Oversized Fat Buttons) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_setup_guide"
                style="@style/Widget.TermuxWidget.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <FrameLayout
                            android:id="@+id/setup_badge_frame"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/widget_icon_badge_bg"
                            android:layout_marginEnd="16dp">

                            <ImageView
                                android:id="@+id/img_setup_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_lucide_settings"
                                app:tint="?attr/colorPrimary"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_setup_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Termux Configuration &amp; Permissions"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/txt_setup_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="allow-external-apps=true • Grant RUN_COMMAND"
                                android:textSize="13sp"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Oversized Bento Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_copy_setup_command"
                            style="@style/Widget.TermuxWidget.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="56dp"
                            android:layout_marginEnd="8dp"
                            android:text="Copy Setup"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="18dp"
                            app:icon="@drawable/ic_lucide_copy"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary"
                            android:textColor="?attr/colorPrimary"
                            app:backgroundTint="?attr/colorSurfaceContainerHigh" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_open_app_settings"
                            style="@style/Widget.TermuxWidget.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="56dp"
                            android:text="Permissions"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="18dp"
                            app:icon="@drawable/ic_lucide_settings"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary"
                            android:textColor="?attr/colorPrimary"
                            app:backgroundTint="?attr/colorSurfaceContainerHigh" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
