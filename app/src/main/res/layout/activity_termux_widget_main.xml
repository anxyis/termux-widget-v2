<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/m3_surface"
    tools:context=".activities.TermuxWidgetMainActivity">

    <!-- Expressive PixelPlayer Collapsible-Style Top Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/main_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/m3_surface"
        app:title="Termux Shortcuts"
        app:titleTextColor="@color/m3_on_surface"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Compact Connection & Sync Strip (Bento Card) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_status_banner"
                style="@style/Widget.TermuxWidget.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/m3_surface_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/widget_icon_badge_bg"
                            android:layout_marginEnd="14dp">

                            <ImageView
                                android:id="@+id/img_status_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_hero_bolt"
                                app:tint="@color/m3_primary"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_status_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Connected to Termux"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/m3_on_surface" />

                            <TextView
                                android:id="@+id/txt_status_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="~/.shortcuts/ • 0 shortcuts"
                                android:textSize="12sp"
                                android:textColor="@color/m3_on_surface_variant" />
                        </LinearLayout>

                        <!-- Refresh All Widgets Action -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_refresh_all_widgets"
                            style="@style/Widget.Material3.Button.IconButton.Filled"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            app:icon="@drawable/ic_hero_arrow_path"
                            app:iconSize="20dp"
                            app:iconTint="@color/m3_primary"
                            app:backgroundTint="@color/m3_primary_container"
                            android:contentDescription="Refresh Widgets" />
                    </LinearLayout>

                    <!-- Oversized Fat Sync Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_refresh_shortcuts"
                        style="@style/Widget.TermuxWidget.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="Sync Scripts from Termux"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        app:backgroundTint="@color/m3_surface_container_high"
                        android:textColor="@color/m3_primary"
                        app:icon="@drawable/ic_hero_arrow_path"
                        app:iconTint="@color/m3_primary"
                        app:iconSize="18dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PRIMARY SECTION: Shortcuts Directory (FIRST & ACCESSIBLE) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SCRIPTS DIRECTORY"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/m3_primary" />

                    <TextView
                        android:id="@+id/txt_shortcuts_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tap to run, or tap for options"
                        android:textSize="11sp"
                        android:textColor="@color/m3_on_surface_variant" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_command"
                    style="@style/Widget.TermuxWidget.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="New Command"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/m3_primary_container"
                    android:textColor="@color/m3_on_primary_container"
                    app:icon="@drawable/ic_lucide_plus"
                    app:iconTint="@color/m3_on_primary_container"
                    app:iconSize="16dp" />
            </LinearLayout>

            <!-- Shortcuts Container -->
            <LinearLayout
                android:id="@+id/container_detected_shortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp" />

            <!-- SECONDARY SECTION: Quick Settings Tiles (Collapsible / Non-dominating) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_tiles_section"
                style="@style/Widget.TermuxWidget.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/m3_surface_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/header_quick_tiles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/widget_icon_badge_bg"
                            android:layout_marginEnd="14dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_lucide_settings"
                                app:tint="@color/m3_primary"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quick Settings Tiles"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/m3_on_surface" />

                            <TextView
                                android:id="@+id/txt_tiles_summary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Configure tiles for Android Control Center"
                                android:textSize="11sp"
                                android:textColor="@color/m3_on_surface_variant" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/img_tiles_expand_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_lucide_chevron_right"
                            app:tint="@color/m3_on_surface_variant"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <!-- Expandable Tiles Grid -->
                    <LinearLayout
                        android:id="@+id/container_tiles_expandable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="14dp">

                        <GridLayout
                            android:id="@+id/grid_quick_tiles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TERTIARY SECTION: Bento Setup Guide & Permissions (Oversized Fat Buttons) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_setup_guide"
                style="@style/Widget.TermuxWidget.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/m3_surface_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/widget_icon_badge_bg"
                            android:layout_marginEnd="14dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_lucide_settings"
                                app:tint="@color/m3_primary"
                                android:contentDescription="@null" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Termux Configuration &amp; Permissions"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/m3_on_surface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="allow-external-apps=true • Grant RUN_COMMAND"
                                android:textSize="12sp"
                                android:textColor="@color/m3_on_surface_variant" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Oversized Bento Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_copy_setup_command"
                            style="@style/Widget.TermuxWidget.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="52dp"
                            android:layout_marginEnd="8dp"
                            android:text="Copy Setup"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_lucide_copy"
                            app:iconSize="18dp"
                            app:iconTint="@color/m3_primary"
                            android:textColor="@color/m3_primary"
                            app:backgroundTint="@color/m3_surface_container_high" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_open_app_settings"
                            style="@style/Widget.TermuxWidget.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="52dp"
                            android:text="Permissions"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_lucide_settings"
                            app:iconSize="18dp"
                            app:iconTint="@color/m3_primary"
                            android:textColor="@color/m3_primary"
                            app:backgroundTint="@color/m3_surface_container_high" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
