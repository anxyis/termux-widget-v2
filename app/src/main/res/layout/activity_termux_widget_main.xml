<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nothing_bg"
    tools:context=".activities.TermuxWidgetMainActivity">

    <!-- Nothing OS Technical Top Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/main_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/nothing_bg"
        app:title="TERMUX // WIDGET"
        app:titleTextColor="@color/nothing_text_primary"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:contentDescription="@null"
        android:src="@color/nothing_border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Technical Status & Sync Bento Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_status_banner"
                style="@style/Widget.TermuxWidget.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/nothing_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/img_status_icon"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@drawable/ic_nothing_red_dot"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_status_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STATUS : CONNECTED"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06"
                                android:textColor="@color/nothing_text_primary" />

                            <TextView
                                android:id="@+id/txt_status_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="PATH : ~/.shortcuts/ • 0 shortcuts"
                                android:textSize="11sp"
                                android:textColor="@color/nothing_text_secondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Technical Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_refresh_shortcuts"
                            style="@style/Widget.TermuxWidget.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="[ SYNC TERMUX ]"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04"
                            app:backgroundTint="@color/nothing_red_dim"
                            android:textColor="@color/nothing_red"
                            app:icon="@drawable/ic_hero_arrow_path"
                            app:iconTint="@color/nothing_red"
                            app:iconSize="14dp"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_refresh_all_widgets"
                            style="@style/Widget.TermuxWidget.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:text="[ REFRESH WIDGETS ]"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04"
                            app:backgroundTint="@color/nothing_surface_elevated"
                            android:textColor="@color/nothing_text_primary"
                            app:icon="@drawable/ic_lucide_terminal"
                            app:iconTint="@color/nothing_text_primary"
                            app:iconSize="14dp"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Compact Technical Setup Helper -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_setup_guide"
                style="@style/Widget.TermuxWidget.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/nothing_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CONFIG : allow-external-apps=true"
                        android:textSize="11sp"
                        android:textColor="@color/nothing_text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_copy_setup_command"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="[ COPY ]"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:textColor="@color/nothing_text_primary"
                        android:padding="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_app_settings"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="[ PERMISSIONS ]"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:textColor="@color/nothing_red"
                        android:padding="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Tiles Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUICK SETTINGS TILES [08]"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/nothing_text_secondary"
                android:layout_marginBottom="8dp" />

            <!-- Quick Tiles Grid -->
            <GridLayout
                android:id="@+id/grid_quick_tiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginBottom="16dp" />

            <!-- Shortcuts Header & Add Command Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SHORTCUT DIRECTORY"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/nothing_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_command"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="[ + ADD COMMAND ]"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:textColor="@color/nothing_red"
                    android:padding="0dp" />
            </LinearLayout>

            <!-- Shortcuts Container -->
            <LinearLayout
                android:id="@+id/container_detected_shortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
