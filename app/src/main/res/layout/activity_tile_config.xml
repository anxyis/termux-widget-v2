<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/m3_surface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_tile_config"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/m3_surface"
        app:title="@string/quick_tile_config_title"
        app:titleTextColor="@color/m3_on_surface"
        app:navigationIcon="@drawable/ic_lucide_chevron_right" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Control Center Tile Preview -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Control Center Preview"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/m3_primary"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.TermuxWidget.Card"
                android:layout_marginBottom="20dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/preview_tile_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/widget_pill_badge_bg"
                        android:padding="8dp"
                        android:src="@drawable/ic_lucide_terminal"
                        android:layout_marginEnd="14dp"
                        app:tint="@color/m3_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/preview_tile_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Termux Tile"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/m3_on_surface" />

                        <TextView
                            android:id="@+id/preview_tile_sublabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quick_tile_ready"
                            android:textSize="12sp"
                            android:textColor="@color/m3_on_surface_variant" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Script Selection Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_tile_select_script"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.TermuxWidget.Card.Outlined"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lucide_code"
                        android:layout_marginEnd="12dp"
                        app:tint="@color/m3_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quick_tile_select_shortcut"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/m3_on_surface" />

                        <TextView
                            android:id="@+id/txt_tile_selected_script"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap to choose script"
                            android:textSize="12sp"
                            android:textColor="@color/m3_on_surface_variant" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lucide_chevron_right"
                        app:tint="@color/m3_on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Icon Selection Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_tile_select_icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.TermuxWidget.Card.Outlined"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/img_tile_chosen_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_lucide_terminal"
                        android:layout_marginEnd="12dp"
                        app:tint="@color/m3_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quick_tile_choose_icon"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/m3_on_surface" />

                        <TextView
                            android:id="@+id/txt_tile_chosen_icon_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Terminal (Lucide)"
                            android:textSize="12sp"
                            android:textColor="@color/m3_on_surface_variant" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lucide_chevron_right"
                        app:tint="@color/m3_on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Custom Label Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_tile_label"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                android:hint="@string/quick_tile_label">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_tile_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Save Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_tile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/quick_tile_save"
                android:textSize="14sp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="10dp" />

            <!-- Test Run Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_test_run_tile"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/quick_tile_test_run"
                app:icon="@drawable/ic_lucide_play"
                app:cornerRadius="16dp"
                android:layout_marginBottom="10dp" />

            <!-- Clear Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_tile"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quick_tile_clear"
                android:textColor="@color/m3_outline"
                app:icon="@drawable/ic_lucide_trash"
                app:iconTint="@color/m3_outline" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
