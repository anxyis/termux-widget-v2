        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceContainer">#0A0A0A</item>
        <item name="colorSurfaceContainerLow">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerHigh">#141416</item>
        <item name="colorSurfaceContainerHighest">#1E1F24</item>
        <item name="colorSurfaceVariant">#101012</item>

        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">#202124</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>

        <item name="colorSecondary">#FFFFFF</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSecondaryContainer">#202124</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>

        <item name="colorTertiary">#FFFFFF</item>
        <item name="colorOnTertiary">#000000</item>
        <item name="colorTertiaryContainer">#202124</item>
        <item name="colorOnTertiaryContainer">#FFFFFF</item>

        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#9E9E9E</item>
        <item name="colorOutline">#555555</item>
        <item name="colorOutlineVariant">#262626</item>

        <item name="android:statusBarColor">#000000</item>
