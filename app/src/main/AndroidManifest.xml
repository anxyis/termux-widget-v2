<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <queries>
        <package android:name="com.termux" />
        <intent>
            <action android:name="com.termux.RUN_COMMAND" />
        </intent>
    </queries>

    <application
        android:name=".TermuxWidgetApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TermuxWidget.Material3"
        tools:ignore="GoogleAppIndexingWarning">

        <!-- 1. List Widget Provider -->
        <receiver
            android:name=".TermuxWidgetProvider"
            android:exported="true"
            android:label="@string/title_shortcut_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/termux_appwidget_info" />
        </receiver>

        <!-- 2. Grid Widget Provider -->
        <receiver
            android:name=".TermuxGridWidgetProvider"
            android:exported="true"
            android:label="@string/title_grid_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/termux_grid_appwidget_info" />
        </receiver>

        <!-- 3. Button Widget Provider -->
        <receiver
            android:name=".TermuxButtonWidgetProvider"
            android:exported="true"
            android:label="@string/title_button_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/termux_button_appwidget_info" />
        </receiver>

        <receiver android:name=".TermuxWidgetControlExecutorReceiver" />

        <receiver
            android:name=".TermuxShortcutSyncReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.termux.widget.v2.SYNC_RESULT" />
            </intent-filter>
        </receiver>

        <!-- Activities -->
        <activity
            android:name=".activities.TermuxWidgetMainActivity"
            android:exported="true"
            android:theme="@style/Theme.TermuxWidget.Material3">
        </activity>

        <activity-alias
            android:name=".activities.TermuxWidgetLauncherActivity"
            android:exported="true"
            android:targetActivity=".activities.TermuxWidgetMainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".activities.TermuxButtonWidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.TermuxWidget.Material3">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.TermuxTileConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.TermuxWidget.Material3" />

        <activity
            android:name=".TermuxCreateShortcutActivity"
            android:exported="true"
            android:label="@string/title_single_shortcut_name"
            android:theme="@style/Theme.TermuxWidget.Material3">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TermuxLaunchShortcutActivity"
            android:exported="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:taskAffinity=".TermuxLaunchShortcutActivity"
            android:theme="@android:style/Theme.NoDisplay" />

        <activity
            android:name="${TERMUX_PACKAGE_NAME}.shared.activities.ReportActivity"
            android:exported="false"
            android:documentLaunchMode="intoExisting"
            android:theme="@style/Theme.TermuxWidget.Material3"
            tools:ignore="MissingClass" />

        <receiver
            android:name=".receivers.SystemEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.MY_PACKAGE_UNSUSPENDED" />
            </intent-filter>
        </receiver>

        <!-- RemoteViews Services -->
        <service
            android:name=".TermuxWidgetService"
            android:exported="true"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <service
            android:name=".TermuxGridWidgetService"
            android:exported="true"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Android 11+ Power Menu Device Controls -->
        <service
            android:name=".TermuxWidgetControlsProviderService"
            android:exported="true"
            android:label="@string/title_termux_shortcuts"
            android:permission="android.permission.BIND_CONTROLS"
            tools:targetApi="r">
            <intent-filter>
                <action android:name="android.service.controls.ControlsProviderService" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tiles (HyperOS, ColorOS, Stock Android) -->
        <service
            android:name=".tiles.TermuxQuickTileServices$TermuxQuickTileService1"
            android:icon="@drawable/ic_lucide_terminal"
            android:label="@string/title_quick_tile_1"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.TermuxQuickTileServices$TermuxQuickTileService2"
            android:icon="@drawable/ic_lucide_terminal"
            android:label="@string/title_quick_tile_2"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.TermuxQuickTileServices$TermuxQuickTileService3"
            android:icon="@drawable/ic_lucide_terminal"
            android:label="@string/title_quick_tile_3"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.TermuxQuickTileServices$TermuxQuickTileService4"
            android:icon="@drawable/ic_lucide_terminal"
            android:label="@string/title_quick_tile_4"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.TermuxQuickTileServices$TermuxQuickTileService5"
            android:icon="@drawable/ic_lucide_terminal"
            android:label="@string/title_quick_tile_5"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.TermuxQuickTileServices$TermuxQuickTileService6"
            android:icon="@drawable/ic_lucide_terminal"
            android:label="@string/title_quick_tile_6"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.TermuxQuickTileServices$TermuxQuickTileService7"
            android:icon="@drawable/ic_lucide_terminal"
            android:label="@string/title_quick_tile_7"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tiles.TermuxQuickTileServices$TermuxQuickTileService8"
            android:icon="@drawable/ic_lucide_terminal"
            android:label="@string/title_quick_tile_8"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
